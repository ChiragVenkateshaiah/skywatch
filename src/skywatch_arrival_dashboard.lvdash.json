{
  "datasets": [
    {
      "catalog": "skywatch",
      "displayName": "Congestion by Ring",
      "name": "congestion",
      "queryLines": [
        "SELECT\n",
        "  minute_ts,\n",
        "  ring,\n",
        "  n_inbound,\n",
        "  mean_eta_min\n",
        "FROM\n",
        "  gold_congestion\n",
        "WHERE\n",
        "  apt_icao = 'KATL'\n",
        "ORDER BY\n",
        "  minute_ts,\n",
        "  ring"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "Recent Landings",
      "name": "touchdowns",
      "queryLines": [
        "SELECT\n",
        "  callsign,\n",
        "  ac_type,\n",
        "  touchdown_ts,\n",
        "  ROUND(min_dist_nm, 2) AS min_dist_nm,\n",
        "  ROUND(min_alt_ft, 0) AS min_alt_ft\n",
        "FROM\n",
        "  gold_touchdowns\n",
        "ORDER BY\n",
        "  touchdown_ts DESC\n",
        "LIMIT 50"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "Aircraft Map",
      "name": "tracks_map",
      "queryLines": [
        "SELECT\n",
        "  icao,\n",
        "  callsign,\n",
        "  ac_type,\n",
        "  lat,\n",
        "  lon,\n",
        "  alt_ft,\n",
        "  gs_kt,\n",
        "  ROUND(dist_to_apt_nm, 0) AS dist_nm,\n",
        "  CASE\n",
        "    WHEN inbound_flag THEN 'inbound'\n",
        "    ELSE LOWER(phase)\n",
        "  END AS category\n",
        "FROM\n",
        "  gold_tracks\n",
        "WHERE\n",
        "  snapshot_ts\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(snapshot_ts)\n",
        "      FROM\n",
        "        gold_tracks\n",
        "    )\n",
        "  AND NOT is_grounded"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "KPIs",
      "name": "kpis",
      "queryLines": [
        "SELECT\n",
        "  aircraft_seen,\n",
        "  inbound_now,\n",
        "  holding_now,\n",
        "  touchdowns_in_window,\n",
        "  window_minutes\n",
        "FROM\n",
        "  skywatch.stream.gold_kpis\n",
        "ORDER BY\n",
        "  as_of_ts DESC\n",
        "LIMIT 1"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "Latest Congestion",
      "name": "congestion_latest",
      "queryLines": [
        "SELECT\n",
        "  ring,\n",
        "  n_inbound,\n",
        "  ROUND(mean_eta_min, 1) AS eta_min\n",
        "FROM\n",
        "  gold_congestion\n",
        "WHERE\n",
        "  apt_icao = 'KATL'\n",
        "  AND minute_ts\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(minute_ts)\n",
        "      FROM\n",
        "        gold_congestion\n",
        "      WHERE\n",
        "        apt_icao = 'KATL'\n",
        "    )\n",
        "ORDER BY\n",
        "  ring"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "Circling Aircraft",
      "name": "holding",
      "queryLines": [
        "SELECT\n",
        "  callsign,\n",
        "  ac_type,\n",
        "  ROUND(mean_alt_ft, 0) AS mean_alt_ft,\n",
        "  ROUND(mean_dist_nm, 1) AS mean_dist_nm,\n",
        "  ROUND(heading_spread, 2) AS heading_spread\n",
        "FROM\n",
        "  gold_holding\n",
        "ORDER BY\n",
        "  heading_spread DESC\n",
        "LIMIT 30"
      ],
      "schema": "stream"
    },
    {
      "catalog": "skywatch",
      "displayName": "ETA Distribution",
      "name": "eta_histogram",
      "queryLines": [
        "SELECT\n",
        "  FLOOR((dist_to_apt_nm / gs_kt * 60) / 2) * 2 AS eta_bin_minutes,\n",
        "  COUNT(*) AS aircraft_count\n",
        "FROM\n",
        "  gold_tracks\n",
        "WHERE\n",
        "  snapshot_ts\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(snapshot_ts)\n",
        "      FROM\n",
        "        gold_tracks\n",
        "    )\n",
        "  AND inbound_flag\n",
        "  AND gs_kt > 60\n",
        "  AND (dist_to_apt_nm / gs_kt * 60) <= 90\n",
        "GROUP BY\n",
        "  FLOOR((dist_to_apt_nm / gs_kt * 60) / 2) * 2\n",
        "ORDER BY\n",
        "  eta_bin_minutes"
      ],
      "schema": "stream"
    },
    {
      "columns": [
        {
          "displayName": "dist_nm",
          "expression": "ROUND(`dist_to_apt_nm`, 0)"
        },
        {
          "displayName": "eta_min",
          "expression": "ROUND(`predicted_eta_min`, 1)"
        }
      ],
      "displayName": "Latest Predictions",
      "name": "predictions_latest",
      "queryLines": [
        "SELECT\n",
        "  scored_at,\n",
        "  model_version,\n",
        "  icao,\n",
        "  callsign,\n",
        "  ac_type,\n",
        "  apt_icao,\n",
        "  snapshot_ts,\n",
        "  dist_to_apt_nm,\n",
        "  gs_kt,\n",
        "  alt_ft,\n",
        "  heading_err_deg,\n",
        "  predicted_eta_min,\n",
        "  predicted_touchdown_ts\n",
        "FROM\n",
        "  skywatch.stream.predictions\n",
        "WHERE\n",
        "  scored_at\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(scored_at)\n",
        "      FROM\n",
        "        skywatch.stream.predictions\n",
        "    )\n",
        "ORDER BY\n",
        "  predicted_touchdown_ts"
      ]
    },
    {
      "columns": [
        {
          "displayName": "mae",
          "expression": "AVG(ABS(`error_min`))"
        },
        {
          "displayName": "error_bin",
          "expression": "FLOOR(`error_min`)"
        }
      ],
      "displayName": "Predictions with Actuals",
      "name": "predictions_scored",
      "queryLines": [
        "SELECT\n",
        "  icao,\n",
        "  callsign,\n",
        "  ac_type,\n",
        "  snapshot_ts,\n",
        "  dist_to_apt_nm,\n",
        "  predicted_eta_min,\n",
        "  predicted_touchdown_ts,\n",
        "  actual_touchdown_ts,\n",
        "  actual_eta_min,\n",
        "  error_min\n",
        "FROM\n",
        "  skywatch.stream.predictions_scored\n",
        "ORDER BY\n",
        "  snapshot_ts DESC"
      ]
    },
    {
      "displayName": "Historical Demand by Hour",
      "name": "gold_demand_hourly",
      "queryLines": [
        "SELECT\n",
        "  hour_utc,\n",
        "  AVG(arrivals) AS avg_arrivals\n",
        "FROM\n",
        "  skywatch.stream.gold_demand_15m\n",
        "WHERE\n",
        "  apt_icao = 'KATL'\n",
        "GROUP BY\n",
        "  hour_utc\n",
        "ORDER BY\n",
        "  hour_utc"
      ]
    },
    {
      "columns": [
        {
          "displayName": "q10_rounded",
          "expression": "ROUND(`predicted_q10`, 1)"
        },
        {
          "displayName": "mean_rounded",
          "expression": "ROUND(`predicted_mean`, 1)"
        },
        {
          "displayName": "q90_rounded",
          "expression": "ROUND(`predicted_q90`, 1)"
        }
      ],
      "displayName": "Latest Demand Forecast",
      "name": "demand_forecast_latest",
      "queryLines": [
        "SELECT\n",
        "  scored_at,\n",
        "  model_version,\n",
        "  apt_icao,\n",
        "  bin_start_ts,\n",
        "  horizon_step,\n",
        "  arrivals_so_far,\n",
        "  predicted_q10,\n",
        "  predicted_q50,\n",
        "  predicted_q90,\n",
        "  predicted_mean\n",
        "FROM\n",
        "  skywatch.stream.demand_forecast\n",
        "WHERE\n",
        "  scored_at\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(scored_at)\n",
        "      FROM\n",
        "        skywatch.stream.demand_forecast\n",
        "    )\n",
        "ORDER BY\n",
        "  horizon_step"
      ]
    }
  ],
